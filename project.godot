config_version=5

[application]
config/name="Kasserine City"
config/description="A native 3D open-world game inspired by Kasserine, Tunisia."
config/icon="res://icon.png"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
# v0.4.4 BACK FIX: Quit On Go Back defaults to true — pressing Android
# back then quits the app even when a node handles
# NOTIFICATION_WM_GO_BACK_REQUEST (the engine queues the quit first).
# That is why back from Settings closed the APK instead of returning
# to the menu. Off: back is now purely navigation, handled by
# menu.gd / gameplay.gd; quitting stays on the QUIT / EXIT buttons.
config/quit_on_go_back=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/boot_splash/bg_color=Color(0.04, 0.07, 0.12, 1)
window/boot_splash/show_image=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
# v0.3.1: bigger directional shadow map on mobile — smaller texels fight
# the wavy shadow-acne moire on the big flat ground and road surfaces.
lights_and_shadows/directional_shadow/size.mobile=4096
environment/defaults/default_clear_color=Color(0.45, 0.68, 0.88, 1)

[autoload]

Settings="*res://scripts/settings.gd"
